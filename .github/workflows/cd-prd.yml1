---
# Continuous Deployment to Production Environment
# Triggers: Manual dispatch only (workflow_dispatch)
# Dependency: CI workflow must have completed successfully on main
# Environment: prd
# Protection: CRITICAL - REQUIRES manual approval via GitHub Environment protection rules

name: Deploy to Production

on:
  workflow_dispatch:
    inputs:
      artifact-version:
        description: 'Artifact version to deploy (REQUIRED for Production)'
        required: true
        type: string
      dry-run:
        description: 'Validate without deploying (dry-run mode)'
        required: false
        type: boolean
        default: false
      force-update:
        description: 'Force update even if version already deployed'
        required: false
        type: boolean
        default: false
      package-registry:
        description: 'Package registry (github or artifactory)'
        required: false
        type: choice
        options:
          - artifactory
          - github
        default: artifactory

permissions:
  id-token: write    # Required for Azure OIDC and JFrog OIDC authentication
  contents: read     # Required for checkout
  actions: read      # Required to read workflow run information

jobs:
  # Validate that CI has completed successfully on main before deploying
  validate-ci:
    name: Validate CI Completion
    runs-on: ubuntu-latest
    steps:
      - name: Check latest CI run on main
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          echo "Checking latest CI workflow run on main branch..."
          LATEST_CI=$(gh run list \
            --repo "${{ github.repository }}" \
            --workflow "CI - Build and Validate" \
            --branch main \
            --status completed \
            --limit 1 \
            --json conclusion,headSha,createdAt \
            --jq '.[0]')

          if [ -z "$LATEST_CI" ] || [ "$LATEST_CI" = "null" ]; then
            echo "::error::No completed CI runs found on main branch"
            exit 1
          fi

          CONCLUSION=$(echo "$LATEST_CI" | jq -r '.conclusion')
          HEAD_SHA=$(echo "$LATEST_CI" | jq -r '.headSha')
          CREATED_AT=$(echo "$LATEST_CI" | jq -r '.createdAt')

          echo "Latest CI run: conclusion=$CONCLUSION, sha=$HEAD_SHA, date=$CREATED_AT"

          if [ "$CONCLUSION" != "success" ]; then
            echo "::error::Latest CI run on main did not succeed (conclusion: $CONCLUSION). Deploy aborted."
            exit 1
          fi

          echo "CI validation passed - latest run on main was successful"

  # Resolve artifact version: use input if provided, otherwise latest GitHub Release from CI
  resolve-version:
    name: Resolve Artifact Version
    runs-on: ubuntu-latest
    needs: validate-ci
    outputs:
      artifact-version: ${{ steps.resolve.outputs.version }}
    steps:
      - name: Determine artifact version
        id: resolve
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          INPUT_VERSION="${{ inputs.artifact-version }}"
          if [ -n "$INPUT_VERSION" ]; then
            echo "Using provided version: $INPUT_VERSION"
            echo "version=$INPUT_VERSION" >> "$GITHUB_OUTPUT"
          else
            echo "No version provided, resolving latest from CI..."
            LATEST_TAG=$(gh release list \
              --repo "${{ github.repository }}" \
              --limit 1 \
              --json tagName \
              --jq '.[0].tagName')

            if [ -z "$LATEST_TAG" ] || [ "$LATEST_TAG" = "null" ]; then
              echo "::error::No releases found. Run CI on main first to publish an artifact."
              exit 1
            fi

            # Strip 'v' prefix from tag (e.g., v1.0.0-42 -> 1.0.0-42)
            VERSION="${LATEST_TAG#v}"
            echo "Resolved latest version from CI: $VERSION (tag: $LATEST_TAG)"
            echo "version=$VERSION" >> "$GITHUB_OUTPUT"
          fi

  # CRITICAL: Approval gate - waits for manual approval before deploying
  # Configure protection rules in GitHub Settings -> Environments -> prd
  # - Required reviewers (minimum 2 approvers for production)
  # - Wait timer (recommend 10-15 minutes for change freeze windows)
  # - Deployment branches: main only
  # - Prevent self-review
  approve-prd:
    name: Approve Production Deployment
    runs-on: ubuntu-latest
    needs: [validate-ci, resolve-version]
    environment: prd
    steps:
      - name: Deployment approved
        run: echo "Production deployment approved"

  deploy-prd:
    name: Deploy API to Production
    needs: [validate-ci, resolve-version, approve-prd]
    uses: jpteam2026/dso-api-reusable/.github/workflows/_reusable-deploy-apim.yml@main
    with:
      application: 'AAZ'
      environment: prd
      variables-path: .github/variables
      artifact-version: ${{ needs.resolve-version.outputs.artifact-version }}
      component-name: azure-api-example
      apim-resource-group: rg-apim-prd
      apim-service-name: apim-prd-example
      dry-run: ${{ inputs.dry-run || false }}
      force-update: ${{ inputs.force-update || false }}
      package-registry: ${{ inputs.package-registry || 'artifactory' }}
      artifactory-repository: dso-generic-release-local
      policy-enabled: true
    secrets:
      DSO_WORKFLOWS_GHAPP_ID: ${{ secrets.DSO_WORKFLOWS_GHAPP_ID }}
      DSO_WORKFLOWS_GHAPP_PK: ${{ secrets.DSO_WORKFLOWS_GHAPP_PK }}
      ARTIFACTORY_TOKEN: ${{ secrets.ARTIFACTORY_TOKEN }}
